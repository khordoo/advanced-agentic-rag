# ─── Vector Store ─────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME='docs'
CHROMA_PERSIST_DIRECTORY='artifacts/chroma_db'
DOCS_DIR='data/source_documents'
PROCESSED_DOCS_DIR='data/processed'
DOCUMENT_STORE_PERSIST_PATH='artifacts/document_store/document_store.pkl'
SYNTHETIC_QA_PERSIST_PATH='data/synthetic/eval_question_answers.json'

# ─── LLM Providers (configure at least one) ──────────────────────────────
# LM Studio (local, OpenAI-compatible)
OPEN_AI_COMPATIBLE_BASE_URL='http://127.0.0.1:1234/v1'

# Ollama (local)
OLLAMA_BASE_URL='http://127.0.0.1:11434'

# Kimi via NVIDIA NIM
NVIDIA_KIMI_K2_BASE_URL='https://integrate.api.nvidia.com/v1'
NVIDIA_KIMI_API_KEY='your_nvidia_api_key_here'

# ─── Embeddings & Reranking ──────────────────────────────────────────────
# Note: EMBEDDING_* controls Postgres dense embeddings.
# Qdrant uses QDRANT_EMBED_MODEL and QDRANT_SPARSE_MODEL for dense+sparse hybrid search.
HF_EMBEDDING_MODEL='sentence-transformers/all-MiniLM-L6-v2'
HF_RERANKER_MODEL='BAAI/bge-reranker-v2-m3'
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ─── Chunk Sizes & Configurations ─────────────────────────────────────────
LLM_MAX_PARALLEL_REQUEST=3
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

#----------------INGESTION -------------------------------------
# Choose the vector db you want to use: qdrant or postgres
INGESTION_INDEXER_BACKEND=postgres
INGESTION_BASE_SOURCE_URI=./data/source_documents
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200
INGESTION_MAX_RETRIES=3
INGESTION_DISCOVERY_BATCH_SIZE=500
INGESTION_WORKER_MAX_ATTEMPTS=3
INGESTION_WORKER_LEASE_DURATION_SECONDS=300
# Optional limit for one ingestion run. If left commented out, max_jobs
# defaults to None and the worker runs until the queue is empty.
# INGESTION_DEFAULT_MAX_JOBS=100
# Runtime-only destructive reset switch. Leave false/commented for normal runs.
# For a one-off rebuild after changing embedding models, pass this as a
# temporary environment variable instead of committing it enabled.
# It will be a DESTRUCTIVE OVERRIDE. Fully wipes existing vectors and "
# metadata before ingestion
# INGESTION_OVERWRITE=false
INGESTION_ALLOWED_EXTENSIONS_RAW=pdf,md
INGESTION_HASH_ALGORITHM=sha256


# ─── Retrieval & Reranker Configs ─────────────────────────────────────────
RETRIVAL_TOP_K=10
RETRIVAL_OVERSAMPLE_FACTOR=5
RETRIVAL_HYBRID_ALPHA=0.5
RETRIVAL_SCORE_THRESHOLD=0.1
RETRIVAL_RRF_SCORE_THRESHOLD=0.05
RERANK_PROVIDER=huggingface
RERANK_TOP_K=10
RERANK_DEVICE=cpu
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
TABLE_CONTEXT_WINDOW=3
SUMMARIZE_TABLES_ENABLED=True
LOG_LEVEL='INFO'
ENV=dev

# __ Generation _____________________
GENERATION_MODEL_PROVIDER="aws"
GENERATION_REASONING_MODEL="openai.gpt-oss-120b-1:0"
GENERATION_VERIFIER_MODEL="openai.gpt-oss-120b-1:0"
GENERATION_FAST_MODEL="amazon.nova-micro-v1:0"
GENERATION_ENABLE_INTENT_ROUTING=true
GENERATION_ENABLE_GROUNDING_VERIFIER=true
GENERATION_MAX_AGENT_ITERATIONS=25
GENERATION_MAX_TOOL_CALLS=15
GENERATION_MAX_SELF_CORRECTION_ATTEMPTS=3
GENERATION_INTENT_ROUTER_LOOKBACK=3
GENERATION_GENERAL_ASSISTANT_LOOKBACK=3

# __ Prompt Profiles _____________________
# Optional: override prompt profile file path.
# PROMPTS_PROFILE_PATH="rag_core/prompts/profiles/default.yaml"
# Strict mode validates unknown keys/package IDs and invalid schemas.
PROMPTS_PROFILE_STRICT=true

# ─── Qdrant (production track) ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=docs
QDRANT_EMBED_MODEL=BAAI/bge-small-en-v1.5
QDRANT_SPARSE_MODEL=prithivida/Splade_PP_en_v1

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infrastructure

POSTGRES_RAG_DB=rag_core
LANGFUSE_DB=langfuse
PERFECT_DB=perfect

#------ Database Connection -----------------------
POSTGRES_POOL_PRE_PING=true
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_TIMEOUT=30
POSTGRES_STATEMENT_TIMEOUT_MS=60000

# ─── LangFuse (observability) ────────────────────────────────────────────
# S3 / MinIO Configuration / Mock S3 Locally (No AWS Account is needed)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minioadmin
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=minioadmin
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

# Generate a strong 32-byte hex key for production (e.g., openssl rand -hex 32)
LANGFUSE_NEXTAUTH_SECRET=your_nextauth_secret_here
LANGFUSE_NEXTAUTH_SALT=your_nextauth_salt_here

# Headless Initialization
LANGFUSE_INIT_ORG_NAME=AI-Operations-Center
LANGFUSE_INIT_PROJECT_NAME=Advanced-RAG-Project
LANGFUSE_INIT_PROJECT_ID=agentic-rag-prod
LANGFUSE_INIT_ORG_ID="ai-ops-center-org"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-admin-001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-admin-001

# Python uses these to talk to the project (Notice no "INIT_PROJECT_")
LANGFUSE_PUBLIC_KEY="pk-lf-admin-001"
LANGFUSE_SECRET_KEY="sk-lf-admin-001"
LANGFUSE_HOST="http://localhost:3000"

# Langfuse Admin User Auto-Init
LANGFUSE_INIT_USER_EMAIL="admin@example.com"
LANGFUSE_INIT_USER_NAME="Admin"
LANGFUSE_INIT_USER_PASSWORD="SuperSecurePassword123!"

# ─── Clickhouse ──────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_password
CLICKHOUSE_CLUSTER_ENABLED=false
