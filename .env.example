# ─── Vector Store ─────────────────────────────────────────────────────────
CHROMA_COLLECTION_NAME='docs'
CHROMA_PERSIST_DIRECTORY='artifacts/chroma_db'
DOCS_DIR='data/source_documents'
PROCESSED_DOCS_DIR='data/processed'
DOCUMENT_STORE_PERSIST_PATH='artifacts/document_store/document_store.pkl'
# DEPRECATED: replaced by EVAL_STATIC_DATASET_NAME. Kept for backward compat.
# SYNTHETIC_QA_PERSIST_PATH='data/synthetic/eval_question_answers.json'

# ─── LLM Providers (configure at least one) ──────────────────────────────
# LM Studio running natively on your Mac/Windows host.
OPEN_AI_COMPATIBLE_BASE_URL='http://host.docker.internal:1234/v1'

# Ollama running natively on your Mac/Windows host.
OLLAMA_BASE_URL='http://host.docker.internal:11434'

# Kimi via NVIDIA NIM
NVIDIA_KIMI_K2_BASE_URL='https://integrate.api.nvidia.com/v1'
NVIDIA_KIMI_API_KEY='your_nvidia_api_key_here'

# ─── Embeddings & Reranking ──────────────────────────────────────────────
# EMBEDDING_MODEL_NAME controls the dense FastEmbed model for all retrieval backends
# and is warmed into the shared FastEmbed Docker volume by model-warmer.
# Qdrant also uses QDRANT_SPARSE_MODEL for sparse hybrid search.
# --- Hugging Face (Optional) ---
# Used to download gated Hugging Face-hosted models into the shared model volume.
# For public models (default), leave this completely blank.
# Only required if you change to a gated model (like Llama-3) or hit IP rate limits.
HF_TOKEN=""
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ─── Chunk Sizes & Configurations ─────────────────────────────────────────
LLM_MAX_PARALLEL_REQUEST=3
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

# ==========================================
# INGESTION PIPELINE SETTINGS
# ==========================================

# --- 1. CORE ROUTING & DISCOVERY ---
# Which vector store backend to use: 'qdrant' or 'postgres'.
# Keep INGESTION_INDEXER_BACKEND and RETRIEVAL_BACKEND aligned, then run a
# fresh ingestion after switching backends so the selected store has data.
INGESTION_INDEXER_BACKEND=qdrant
# The root URI or local directory path for source documents
INGESTION_BASE_SOURCE_URI=./data/source_documents
# Comma-separated list of allowed file extensions
INGESTION_ALLOWED_EXTENSIONS_RAW=pdf,md

# --- 2. PROCESSING & INDEXING LOGIC ---
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=200
# Postgres dictionary for Full-Text Search (e.g., 'english' or 'simple' for mixed languages)
INGESTION_FTS_LANGUAGE=english
INGESTION_HASH_ALGORITHM=sha256

# --- 3. WORKER & QUEUE TUNING (Advanced) ---
# Optional limit for one ingestion run. Leave commented to process all files.
# INGESTION_DEFAULT_MAX_JOBS=100
INGESTION_DISCOVERY_BATCH_SIZE=500
# Fail discovery when zero eligible assets are found (recommended for ops safety).
# Set true only if empty-source runs are intentional.
INGESTION_ALLOW_EMPTY_DISCOVERY=false
INGESTION_WORKER_MAX_ATTEMPTS=3
INGESTION_WORKER_LEASE_DURATION_SECONDS=300
INGESTION_WORKER_PREFLIGHT_EXTENSION_SECONDS=60

# --- 4. DANGER ZONE ---
# ⚠️ DANGER: DESTRUCTIVE OVERRIDE. Fully wipes existing vectors and metadata.
# Use ONLY as a temporary environment variable injection (e.g., docker run -e INGESTION_OVERWRITE=true).
# DO NOT uncomment or set to 'true' here to prevent accidental unrecoverable data loss.
# INGESTION_OVERWRITE=false


# ─── Retrieval & Reranker Configs ─────────────────────────────────────────
RETRIEVAL_TOP_K=10
RETRIEVAL_OVERSAMPLE_FACTOR=5
# Backend used by runtime retrieval service ('qdrant' or 'postgres').
# For Qdrant mode, set both:
#   INGESTION_INDEXER_BACKEND=qdrant
#   RETRIEVAL_BACKEND=qdrant
# Then run `make ingest` or the Prefect `ingest-documents` deployment.
RETRIEVAL_BACKEND=qdrant
# Single dense-vs-text balance dial: dense=alpha, text=(1-alpha)
RETRIEVAL_HYBRID_ALPHA=0.5
# Postgres app-level weighted-RRF constant. Default 2 is intentional for top-hit RAG precision.
RETRIEVAL_POSTGRES_RRF_K=2
# Optional Qdrant native RRF k override.
# Leave this commented out to use Qdrant native defaults.
# IMPORTANT: Do NOT set an empty value (RETRIEVAL_QDRANT_RRF_K=). It fails settings parsing.
# RETRIEVAL_QDRANT_RRF_K=60
# Do not expect exact cross-backend rank parity between qdrant and postgres.
RETRIEVAL_SCORE_THRESHOLD=0.1
RETRIEVAL_RRF_SCORE_THRESHOLD=0.05


RERANK_ENABLED=true 

RERANK_PROVIDER=fastembed
RERANK_MODEL_NAME=jinaai/jina-reranker-v2-base-multilingual
# Bedrock reranking reuses RERANK_MODEL_NAME as the Bedrock rerank model ID
# (for example, provider=bedrock, model_name= cohere.rerank-v3-5:0 or amazon.rerank-v1:0) and requires AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_DEFAULT_REGION. 
RERANK_TOP_K=10
RERANK_DEVICE=cpu

TABLE_CONTEXT_WINDOW=3
SUMMARIZE_TABLES_ENABLED=True
LOG_LEVEL='INFO'
ENV=dev

# ─── API / Web UI Identity & Ports ──────────────────────────────────────
# Public model identifier shown by /v1/models and used by OpenAI-compatible clients.
RAG_MODEL_ID=advanced-rag-agent
RAG_API_PORT=8000
OPENAI_API_BASE_URL=http://rag_api:8000/v1
OPENAI_API_KEY=dummy_key
RAG_WEBUI_PORT=3000
RAG_LOCAL_UI_PORT=8501

# ==========================================
# ADVANCED BUILD ARGS (Power Users Only)
# ==========================================
# These dictate the Python packages installed during Docker build.
# They default safely in docker-compose.yaml. ONLY uncomment and modify
# these if you are building slim, specialized production images.
#
# RAG_API_UV_SYNC_EXTRAS="--extra api --extra ui"
# PREFECT_WORKER_UV_SYNC_EXTRAS="--extra ingestion --extra doc-processing --extra eval"

# __ Generation _____________________
GENERATION_MODEL_PROVIDER="aws"
GENERATION_REASONING_MODEL="openai.gpt-oss-120b-1:0"
GENERATION_VERIFIER_MODEL="openai.gpt-oss-120b-1:0"
GENERATION_FAST_MODEL="amazon.nova-micro-v1:0"
GENERATION_ENABLE_INTENT_ROUTING=true
GENERATION_ENABLE_GROUNDING_VERIFIER=true
GENERATION_MAX_AGENT_ITERATIONS=25
GENERATION_MAX_TOOL_CALLS=15
GENERATION_MAX_SELF_CORRECTION_ATTEMPTS=3
GENERATION_INTENT_ROUTER_LOOKBACK=3
GENERATION_GENERAL_ASSISTANT_LOOKBACK=3
# ==========================================
# 🛡️ SECURITY & AGENT BEHAVIOR
# ==========================================
# SECURITY: Drops frontend system prompts to prevent prompt injection jailbreaks.
# Default is True for production. Set to False locally to test new personas.
GENERATION_DROP_FRONTEND_SYSTEM_PROMPTS=True

# __ Prompt Profiles _____________________
# Optional: override prompt profile file path.
# PROMPTS_PROFILE_PATH="rag_core/prompts/profiles/default.yaml"
# Strict mode validates unknown keys/package IDs and invalid schemas.
PROMPTS_PROFILE_STRICT=true

# ─── Qdrant (production track) ───────────────────────────────────────────
# Note: If running bare-metal Python scripts outside Docker, change Docker
# service hostnames such as qdrant/core-db/prefect-server/phoenix/rag_api to
# localhost or another reachable host. Makefile host-run targets already do
# this translation through HOST_* variables.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=docs
QDRANT_SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_HOST=core-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infrastructure

POSTGRES_RAG_DB=rag_core
PERFECT_DB=perfect
PREFECT_UI_PORT=4200
PREFECT_WORK_POOL=rag-work-pool
PREFECT_DEPLOYMENT_NAME=ingest-documents
PREFECT_INIT_MAX_WAIT=120
# Python logger namespaces that Prefect should capture into flow/task run logs.
PREFECT_LOGGING_EXTRA_LOGGERS=rag_core,evaluation
PREFECT_WORKER_LIMIT=2
PREFECT_API_URL=http://prefect-server:4200/api

#------ Database Connection -----------------------
POSTGRES_POOL_PRE_PING=true
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_TIMEOUT=30
POSTGRES_STATEMENT_TIMEOUT_MS=60000

# ─── Observability (OpenTelemetry / OpenInference) ───────────────────────
# Docker compose sends traces to the Phoenix service by default.
# For host-side CLI runs against compose Phoenix, override this to:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PORT=6006
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://phoenix:6006/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=advanced-rag

# ─── Evaluation: Global Judge & Platform Settings ────────────────────────
# Preferred names use the EVAL_STATIC_ and EVAL_DRIFT_ prefixes below.
# Optional override only. Leave commented out to auto-resolve from Phoenix/OTEL.
# EVAL_PHOENIX_ENDPOINT=
EVAL_PHOENIX_PROJECT=advanced-rag-eval
EVAL_JUDGE_PROVIDER=aws
EVAL_JUDGE_MODEL=openai.gpt-oss-120b-1:0
EVAL_TIMEOUT=120
EVAL_MAX_RETRIES=3
EVAL_MAX_WORKERS=4
EVAL_RAGAS_METRICS=faithfulness,answer_relevancy,context_recall,context_precision,answer_correctness
EVAL_PHOENIX_EVALUATORS=hallucination,qa_correctness,relevance
# JSON dict of metric -> minimum score. Empty = warn-only (never fails).
# Example: EVAL_THRESHOLDS='{"faithfulness": 0.9, "context_recall": 0.85}'
EVAL_THRESHOLDS=
# Weight for factual correctness in RAGAS AnswerCorrectness (0.0–1.0).
# Semantic similarity weight is automatically 1.0 − this value.
# Higher = stricter factual overlap scoring.
EVAL_FACTUALITY_WEIGHT=0.85

# ─── Evaluation: Static Datasets (`make eval`) ───────────────────────────
EVAL_STATIC_SCHEDULE_CRON=
EVAL_STATIC_DATASET_NAME=ground-truth-v1
EVAL_STATIC_DATASET_CSV_PATH=evaluation/datasets/ground_truth_dataset.csv
EVAL_STATIC_MAX_EXAMPLES=
EVAL_STATIC_CSV_ARTIFACT_ENABLED=false
EVAL_STATIC_POST_INGESTION_HOOK=false
EVAL_STATIC_RERANK_ENABLED=true

# ─── Evaluation: Continuous Drift (`make eval-drift`) ───────────────────
EVAL_DRIFT_SCHEDULE_CRON=
EVAL_DRIFT_LOOKBACK_MINUTES=60
# eval-drift stratifies production traces into two cohorts:
#   High-Risk: traces where the verifier intervened (intervention_count > 0)
#   Baseline:  clean first-try traces (intervention_count == 0)
EVAL_DRIFT_HIGH_RISK_SAMPLE_MAX=100
# Random sample of clean first-try traces per drift run (kept low to save judge cost).
EVAL_DRIFT_BASELINE_SAMPLE_MAX=20
