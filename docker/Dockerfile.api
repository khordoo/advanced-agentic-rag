FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
# Make Python Docker-friendly (prevents weird log buffering and cache issues)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
ENV FASTEMBED_CACHE_DIR=/app/.cache/fastembed

WORKDIR /app

# Hatchling requires the README to validate package metadata during the sync.
COPY pyproject.toml uv.lock README.md ./

ARG UV_SYNC_EXTRAS="--extra api"
RUN uv sync --frozen --no-dev --no-install-project ${UV_SYNC_EXTRAS} && uv cache clean


COPY rag_core/ rag_core/
COPY app/ app/
COPY examples/ examples/
COPY docker/entrypoint-ui.sh /entrypoint-ui.sh
RUN chmod +x /entrypoint-ui.sh


EXPOSE 8000

CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
