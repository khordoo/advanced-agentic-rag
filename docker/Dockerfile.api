FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
# Make Python Docker-friendly (prevents weird log buffering and cache issues)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Hatchling requires the README to validate package metadata during the sync.
COPY pyproject.toml uv.lock README.md ./

ARG UV_SYNC_EXTRAS="--extra api"
RUN uv sync --frozen --no-dev --no-install-project ${UV_SYNC_EXTRAS}

ARG API_ENABLE_CPU_RERANK=true
ARG TORCH_CPU_INDEX_URL="https://download.pytorch.org/whl/cpu"
RUN if [ "${API_ENABLE_CPU_RERANK}" = "true" ]; then \
      uv pip install --python .venv/bin/python --index-url "${TORCH_CPU_INDEX_URL}" "torch==2.12.0+cpu" && \
      uv pip install --python .venv/bin/python \
        "langchain>=0.3.0" \
        "sentence-transformers==5.3.0" \
        "transformers==4.57.1" \
        "huggingface-hub==0.36.0"; \
    fi


COPY rag_core/ rag_core/
COPY app/ app/


EXPOSE 8000

CMD [".venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
