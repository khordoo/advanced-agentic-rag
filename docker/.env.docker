# Docker-specific environment configuration
# Copy this to .env in the docker/ directory and adjust as needed

# ─── Qdrant ──────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=docs

# ─── LangFuse ────────────────────────────────────────────────────────────
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key

# ─── Embeddings & Reranking ──────────────────────────────────────────────
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── Chunk Sizes ─────────────────────────────────────────────────────────
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50
RERANK_TOP_N=3

# ─── LLM Provider ───────────────────────────────────────────────────────
# Configure your LLM provider here
# AWS_DEFAULT_REGION=us-east-1
# OLLAMA_BASE_URL=http://host.docker.internal:11434
