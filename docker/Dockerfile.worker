FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
ENV FASTEMBED_CACHE_DIR=/app/.cache/fastembed

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libxcb1 \
    libgl1 \
    libsm6 \
    libice6 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libglib2.0-0 \
    libnss3 \
    libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

ARG UV_SYNC_EXTRAS="--extra ingestion --extra doc-processing --extra eval"
RUN set -eux; \
    if echo " ${UV_SYNC_EXTRAS} " | grep -q -- "--extra eval"; then \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential; \
    fi; \
    uv sync --frozen --no-dev --no-install-project ${UV_SYNC_EXTRAS}; \
    if echo " ${UV_SYNC_EXTRAS} " | grep -q -- "--extra eval"; then \
    apt-get purge -y --auto-remove build-essential; \
    rm -rf /var/lib/apt/lists/*; \
    fi

# Warm up RapidOCR to bake ONNX models into the image layer (if installed)
RUN /app/.venv/bin/python -c "import rapidocr_onnxruntime" 2>/dev/null \
    && /app/.venv/bin/python -c "from rapidocr_onnxruntime import RapidOCR; RapidOCR()" \
    || true

COPY rag_core/ rag_core/
COPY orchestration/ orchestration/
COPY evaluation/ evaluation/
COPY db/ db/
COPY app/ app/
# Portable entrypoint: pre-flight init → exec worker
COPY docker/entrypoint-worker.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
